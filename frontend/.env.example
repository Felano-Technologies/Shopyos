# =====================================================
# SHOPYOS FRONTEND - ENV EXAMPLE
# Copy to .env and replace values
# =====================================================

# Set to true to use local dev URLs, false to use Railway production URLs
EXPO_PUBLIC_DEV_MODE=false

# Production URLs
EXPO_PUBLIC_API_URL=https://api.shopyosgh.com
EXPO_PUBLIC_SOCKET_URL=https://socket.shopyosgh.com

# Dev URLs (local)
EXPO_PUBLIC_DEV_API_URL=http://localhost:5000
EXPO_PUBLIC_DEV_SOCKET_URL=http://localhost:5001

# Google OAuth (same Web client ID for all platforms with expo-auth-session)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_web_client_id

# Map tiles — free key from https://stadiamaps.com (no credit card needed).
# Without this, every <UrlTile> map falls back to the raw OSM demo server,
# which throttles production app traffic and is why maps can load slowly.
EXPO_PUBLIC_STADIA_API_KEY=your_stadia_maps_api_key
