{
  "expo": {
    "name": "Shopyos",
    "slug": "shopyos",
    "owner": "eugeneanokye99",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/logo - blue.png",
    "scheme": [
      "shopyos",
      "com.eugeneanokye99.shopyos",
      "com.googleusercontent.apps.683446864153-lmpgj403l7ip1jufnkqd2ue5b4prv09a"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.eugeneanokye99.shopyos",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "If you're delivering an order as a Shopyos driver, we use your location — including while the app is in the background — to share your live position with the customer so they can track their delivery on a map and see an accurate arrival time. We only track your location while a delivery is active.",
        "NSLocationWhenInUseUsageDescription": "Shopyos uses your location to show stores and delivery times near you, and, if you're a driver, to calculate your distance to pickup and drop-off addresses.",
        "NSMicrophoneUsageDescription": "Allow Shopyos to access your microphone for voice calls.",
        "UIBackgroundModes": [
          "location",
          "audio",
          "remote-notification",
          "voip"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "bitcode": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo - blue.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.eugeneanokye99.shopyos",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/adaptive-icon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withVoipPushKit",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "If you're delivering an order as a Shopyos driver, we use your location — including while the app is in the background — to share your live position with the customer so they can track their delivery and see an accurate arrival time. We only track your location while a delivery is active.",
          "locationAlwaysPermission": "Shopyos shares your live location with the customer in the background only while you have an active delivery, so they can track their order's progress and get an accurate arrival estimate.",
          "locationWhenInUsePermission": "Shopyos uses your location to show stores and delivery times near you, and, if you're a driver, to calculate your distance to pickup and drop-off addresses.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-task-manager",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Shopyos to access your camera"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f2f2f2",
          "image": "./assets/images/icondark-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "android": {
            "backgroundColor": "#f2f2f2",
            "resizeMode": "contain",
            "imageWidth": 200
          },
          "ios": {
            "backgroundColor": "#f2f2f2",
            "resizeMode": "contain",
            "imageWidth": 200
          },
          "dark": {
            "image": "./assets/images/icondark-splash.png",
            "backgroundColor": "#f2f2f2"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo - blue.png",
          "color": "#7CCB13"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Shopyos to access your photos to upload product images and documents.",
          "cameraPermission": "Allow Shopyos to access your camera to take photos for uploads."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Shopyos to access your photos to attach and save media.",
          "savePhotosPermission": "Allow Shopyos to save photos and videos to your library."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Shopyos to use Face ID to secure your account."
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-video",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "expo-image",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ce559e8d-1b1f-4182-9129-a1e0bf653b92"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ce559e8d-1b1f-4182-9129-a1e0bf653b92"
    }
  }
}
