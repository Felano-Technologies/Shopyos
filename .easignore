# EAS Build project archive exclusions.
#
# This is a monorepo (frontend/backend/admin all under one repo, and
# frontend/ has no .git of its own), so EAS Build's default archiving
# climbs to this repo root and can sweep in backend/ and admin/ — neither
# is needed to build the mobile app. Once this file exists, EAS stops
# consulting .gitignore ENTIRELY (for the whole repo, not just this level),
# so everything frontend/.gitignore was excluding is repeated below with a
# frontend/ prefix — removing this file's exclusions without replacing them
# would silently pull gigabytes of local build artifacts back into future
# archives (frontend/android/ alone was measured at 1.2GB locally).

# Sibling workspace packages — not needed to build the mobile app
/backend/
/admin/

# frontend/.gitignore, mirrored with a frontend/ prefix
frontend/node_modules/
frontend/.expo/
frontend/dist/
frontend/web-build/
frontend/expo-env.d.ts
frontend/*.orig.*
frontend/*.jks
frontend/*.p8
frontend/*.p12
frontend/*.key
frontend/*.mobileprovision
frontend/.metro-health-check*
frontend/npm-debug.*
frontend/yarn-debug.*
frontend/yarn-error.*
frontend/.DS_Store
frontend/*.pem
frontend/.env*.local
frontend/*.tsbuildinfo
frontend/android/
frontend/ios/
frontend/.env
frontend/coverage/

# General
.git/
.DS_Store
